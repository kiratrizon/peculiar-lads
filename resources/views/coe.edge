				<img class="theme-icon h-9 w-9 mx-auto mb-2" src="/assets/peculiarlads-icon-dark.png" alt="{{ env('GUILD_NAME') }}" />
				<h1 class="text-2xl font-bold" style="color: var(--text-main);">PeculiarLads Code of Ethics</h1>
			</div>

			<div class="coe-body text-sm md:text-base">{{ content }}</div>

