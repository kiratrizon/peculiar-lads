				<div class="mt-8 pt-6 border-t text-center" style="border-color: var(--border);">
					<p class="coe-note text-sm">
						You've already acknowledged the Code of Ethics. Welcome aboard!
					</p>
				</div>
			@elseif(user)
				<div class="mt-8 pt-6 border-t text-center" style="border-color: var(--border);">
