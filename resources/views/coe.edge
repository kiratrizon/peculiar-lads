@if($user && !$alreadyAccepted)
<script>
(function () {
	var button = document.getElementById("coe-accept");
	var hint = document.getElementById("coe-hint");
	if (!button) return;

	var unlockAt = parseInt(button.getAttribute("data-unlock-at"), 10);
	if (!unlockAt) return;

	var defaultHint = hint ? hint.textContent.trim() : "";

	var tick = function () {
		var remaining = unlockAt - Date.now();

		if (remaining <= 0) {
			button.disabled = false;
			if (hint) hint.textContent = "Thanks for reading. You can acknowledge it now.";
			return;
		}

		var totalSeconds = Math.ceil(remaining / 1000);
		var minutes = Math.floor(totalSeconds / 60);
		var seconds = totalSeconds % 60;
		if (hint) {
			hint.textContent = defaultHint + " (" + minutes + ":" + (seconds < 10 ? "0" : "") + seconds + " left)";
		}
		setTimeout(tick, 1000);
	};

	tick();
})();
</script>
@end
